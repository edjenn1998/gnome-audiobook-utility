#!/bin/sh
# Keep test state and temporary media in this checkout, separate from real accounts.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PYTHONDONTWRITEBYTECODE=1
"$ROOT/tools/run-local" "$ROOT/.venv/bin/python" -B "$ROOT/tools/check.py" "$@"
"$ROOT/.venv/bin/ruff" check --no-cache "$ROOT/src" "$ROOT/tests" "$ROOT/tools" "$ROOT/package_sources.py" "$ROOT/setup.py"
git -C "$ROOT" diff --check
